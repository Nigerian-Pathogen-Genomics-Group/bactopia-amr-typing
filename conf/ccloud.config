// Carolina Cloud executor. Lines taken from their quickstart; NOT TESTED with Bactopia.
// Needs an S3 bucket (their pipeline bucket) and the key stored with: nextflow secrets set CCLOUD_API_KEY "..."
// Their docs say to add: -plugins nf-ccloud@1.2.0 (another page says use NXF_PLUGINS_DEFAULT instead).
plugins { id 'nf-ccloud@1.2.0' }
process.executor = 'ccloud'

ccloud {
    apiKey   = secrets.CCLOUD_API_KEY
    endpoint = 'https://console.carolinacloud.io'
}

workDir = 's3://YOUR-BUCKET-NAME/work/'

aws {
    accessKey = System.getenv('AWS_ACCESS_KEY_ID')
    secretKey = System.getenv('AWS_SECRET_ACCESS_KEY')
    region    = 'auto'
    client { endpoint = System.getenv('AWS_ENDPOINT_URL') }
}
